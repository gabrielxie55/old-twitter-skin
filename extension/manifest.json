{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShort__",
  "version": "0.13.3",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "homepage_url": "https://github.com/gabrielxie55/old-twitter-skin",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "styles.css",
        "era2010.css"
      ],
      "js": [
        "dev-reload.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
