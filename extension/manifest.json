{
  "manifest_version": 3,
  "name": "古早推特皮肤（非官方）",
  "short_name": "古早推特",
  "version": "0.12.3",
  "description": "把 x.com 换成 2010 云朵版或 2013 黑色导航栏版的古早推特样子。只改外观，不读取、不上传任何数据。非官方插件，与 X Corp. 无关。",
  "homepage_url": "https://github.com/gabrielxie55/old-twitter-skin",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "古早推特皮肤",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "styles.css",
        "era2010.css"
      ],
      "js": [
        "dev-reload.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
